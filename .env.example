# ===== 基础 =====
PORT=8787
HOST=127.0.0.1
# 仅当 HOST=0.0.0.0 时需要；请求头 Authorization: Bearer <token>
ACCESS_TOKEN=
TZ=Asia/Shanghai
DB_PATH=./data/radar.db
LOG_LEVEL=info

# ===== 采集 =====
# 全局周期：30 分钟
SCAN_INTERVAL_SEC=1800
# 设为 false 可停用自动调度（手动扫描仍可用）
SCHEDULER_ENABLED=true

# GitHub Releases（可选 token，未登录 60 次/小时；304 不计入）
GITHUB_TOKEN=
GITHUB_REPOS=openai/openai-python,langchain-ai/langchain,vllm-project/vllm,ollama/ollama,ggml-org/llama.cpp,modelcontextprotocol/servers,huggingface/transformers

# RSS：逗号分隔；留空则使用内置官方/媒体列表
RSS_FEEDS=

# sitemap 爬虫：逗号分隔站点根地址；留空则使用内置白名单
CRAWL_SITES=
CRAWL_MAX_PAGES=20
CRAWL_DELAY_MS=2000

# GDELT 本次实测不可达，默认关闭；P1 复测后再开
GDELT_ENABLED=false

# X / Twitter（twitterapi.io）：默认关闭，需付费额度
X_ENABLED=false
X_POLL_INTERVAL_SEC=1800
X_DAILY_BUDGET_USD=1.0
TWITTERAPI_KEY=
X_OFFICIAL_ACCOUNTS=OpenAI,AnthropicAI,GoogleDeepMind,huggingface,MetaAI,MistralAI,deepseek_ai,Alibaba_Qwen

# ===== 核验 =====
# 本期不接 AI，使用规则核验
VERIFY_MODE=rules
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
PUSH_MIN_CREDIBILITY=0.65
PUSH_MIN_DOMAINS=2
ALERT_MAX_PER_WATCH_PER_HOUR=5
ALERT_MAX_PER_WATCH_PER_DAY=30

# ===== 页面通知 =====
INPAGE_ENABLED=true
INPAGE_TOAST_MS=4800
INPAGE_MODAL_MIN_SCORE=0.88
INPAGE_SOUND=false

# ===== 邮件 =====
MAIL_ENABLED=true
# ethereal：Nodemailer 测试箱，生成预览链接，不真实投递
# smtp：真实投递；163 需开启 SMTP 并使用「授权码」，不是登录密码
MAIL_TRANSPORT=ethereal
MAIL_TO=anysong7@163.com
MAIL_FROM="SIGNAL Radar <radar@localhost>"
MAIL_MERGE_WINDOW_SEC=120
MAIL_MAX_PER_HOUR=5
MAIL_MAX_PER_DAY=20
# 例：23:00-08:00；留空关闭
MAIL_QUIET_HOURS=

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
