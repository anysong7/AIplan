{
  "name": "signal-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SIGNAL - 本地优先的 AI 热点雷达",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
